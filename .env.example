# The Sheet ID for your LEADS spreadsheet (can be a NEW Google Sheet, separate
# from your content calendar one — copy the ID from its URL, same way as before)
LEADS_SHEET_ID=

# Reuse your existing Google Cloud project's service account key.
# Local development: path to the downloaded JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json

# Reuse your existing free Gemini API key from the content calendar project
GEMINI_API_KEY=

# NEW: a Google Places API key (see README for how to create this — it's a
# different type of key than your service account, just a simple API key)
GOOGLE_PLACES_API_KEY=
